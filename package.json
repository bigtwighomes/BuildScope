{
  "name": "buildscope-check",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Evidence-linked comparison of construction proposals with optional, licensed planning references.",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify:browser": "node scripts/browser-check.mjs",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "unpdf": "^1.9.1"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "axe-core": "^4.10.3",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.2",
    "pdf-lib": "^1.17.1",
    "playwright-core": "^1.64.1",
    "prettier": "^3.9.10",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  }
}
