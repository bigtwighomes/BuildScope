# BuildScope Check environment template. Never place real secrets in this file.

# Server-side application URL. Not a secret.
BUILDSCOPE_APP_URL=http://localhost:3000

# Cost reference mode: OFF | DEMO | LICENSED
# OFF is the required default. DEMO is blocked in production.
# LICENSED additionally requires BUILDSCOPE_COST_DATA_LICENSE_APPROVED=true
# after documented owner approval of commercial data rights.
BUILDSCOPE_COST_DATA_MODE=OFF
BUILDSCOPE_COST_DATA_LICENSE_APPROVED=false

# Payments: disabled | test | live
# live additionally requires BUILDSCOPE_LIVE_PAYMENTS_APPROVED=true
# after documented owner approval. P0 uses disabled only.
BUILDSCOPE_PAYMENT_MODE=disabled
BUILDSCOPE_LIVE_PAYMENTS_APPROVED=false

# Stripe test-mode placeholders. Leave blank until payment work is authorized.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# AI provider placeholder. Not activated in P0. Never use a free endpoint
# for confidential documents without a documented data-rights assessment.
AI_PROVIDER_API_KEY=
